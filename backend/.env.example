# RetailEdge AI Backend Environment
# Copy to .env and edit as needed

# YOLO model weights path (relative to worker.py)
YOLO_MODEL_PATH=yolo11n.pt

# Video source: 0 = webcam, or full path to an .mp4 file
# YOLO_SOURCE=0
# YOLO_SOURCE=C:\Users\yaswa\Videos\retail_demo.mp4
YOLO_SOURCE=0

# How often (seconds) to write shelf status to the database
DB_SAVE_INTERVAL=5

# Set HEADLESS=1 to run worker without OpenCV window (server/CI mode)
HEADLESS=0
